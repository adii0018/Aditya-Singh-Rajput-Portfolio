# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# Formspree form ID — get yours at https://formspree.io/
# Used by the contact form in src/components/sections/Contact.tsx
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_form_id_here

# Google Search Console Verification code (HTML tag verification token)
# Leave empty or omit if verifying via DNS or other methods.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code_here
